#!/usr/bin/env sh
##############################################################################
##
##  Gradle start up script for UN*X
##
##############################################################################

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS=""

APP_NAME=Gradle

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD="maximum"

warn() {
    echo "$*"
}

die() {
    echo
    echo "$*"
    echo
    exit 1
}

# Determine the real location of the script, resolving symlinks.
PRG="$0"

while [ -h "$PRG" ] ; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done

PRGDIR=`dirname "$PRG"`

# Support running from repository root if script invoked from there:
# If this script is at repo-root/gradlew but your Android project is in android/,
# the workflow uses "-p android". We place this script inside android/ to match the workflow.
# Resolve to absolute path
ABSOLUTE_PRGDIR=`cd "$PRGDIR" && pwd`

# Set GRADLE_HOME to the wrapper location
GRADLE_HOME="$ABSOLUTE_PRGDIR"

CLASSPATH="$GRADLE_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$CLASSPATH" ]; then
  die "ERROR: Cannot find gradle wrapper JAR at $CLASSPATH. Please ensure gradle-wrapper.jar is present in gradle/wrapper/ and committed."
fi

JAVA_CMD=${JAVA_HOME:-java}
if [ -n "$JAVA_HOME" ] ; then
  if [ -x "$JAVA_HOME/bin/java" ] ; then
    JAVA_CMD="$JAVA_HOME/bin/java"
  fi
fi

# Execute the wrapper
exec "$JAVA_CMD" $DEFAULT_JVM_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
