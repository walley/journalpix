# Database Configuration
# SQLite (default, fully implemented):
DATABASE_URL=sqlite:journalpix.db
DATABASE_TYPE=sqlite
# PostgreSQL (schema exists in migrations/0001 but backend is NOT implemented yet):
# DATABASE_URL=postgres://username:password@localhost:5432/journalpix
# DATABASE_TYPE=postgres

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION_DAYS=30

# File Storage
UPLOAD_DIR=./uploads
THUMBNAIL_DIR=./thumbnails

# Server Configuration
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://10.0.2.2:8080
