# Database Configuration
# For PostgreSQL:
# DATABASE_URL=postgres://username:password@localhost:5432/journalpix
# For SQLite:
# DATABASE_URL=sqlite:journalpix.db
# or
# DATABASE_URL=journalpix.db

DATABASE_URL=postgres://localhost:5432/journalpix
DATABASE_TYPE=postgres  # Options: postgres, sqlite

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION_DAYS=30

# File Storage
UPLOAD_DIR=./uploads
THUMBNAIL_DIR=./thumbnails

# Server Configuration
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://10.0.2.2:8080
