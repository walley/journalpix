# JournalPix backend configuration (INI style)
#
# Install location: /usr/local/etc/journalpix.conf (or $PREFIX/etc).
# Every key is optional — built-in defaults are used for anything missing.
# Environment variables (DATABASE_URL, SERVER_PORT, ...) still override this
# file, for backward compatibility.

[server]
# HTTP port to listen on
port = 8080

[database]
# sqlite (fully implemented) | postgres (schema exists, backend not implemented)
type = sqlite
# sqlite accepts "sqlite:path", a bare path, or empty for in-memory
url = sqlite:journalpix.db

[auth]
# JWT_SECRET — the secret key used to SIGN login tokens (JWTs).
#
# How it works: when a user logs in, the server creates a token containing
# {user_id, email, expiry} and signs it with this secret. Every later request
# that sends "Authorization: Bearer <token>" is verified by re-signing the
# token with the SAME secret and comparing — if it matches, the user is
# authenticated without a password.
#
# Why you must change it: anyone who knows the secret can FORGE a valid token
# for ANY user (full account takeover) without knowing any password. The
# built-in default is public knowledge (it's in the source code), so leaving
# it unchanged means anyone can impersonate any user.
#
# How to generate a good one, e.g.:
#   head -c 32 /dev/urandom | base64
#
# Consequences of changing it later: all existing login tokens immediately
# stop working (users simply have to log in again); nothing else is affected.
# Passwords are NOT affected — they are hashed with bcrypt, not with this.
jwt_secret = default_secret_change_in_production
# JWT lifetime in days (how long a login token stays valid)
jwt_expiration_days = 30

[storage]
# Where uploaded photos and thumbnails are stored (created if missing).
# Relative paths are resolved against the working directory of the process.
upload_dir = ./uploads
thumbnail_dir = ./thumbnails

[cors]
# Comma-separated list of allowed origins
origins = http://localhost:3000,http://localhost:8080
